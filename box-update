#!/usr/bin/env bash
# Обновление обвязки agent-box в проекте: файлы agent-box — свежей копией из последнего коммита клона, заготовки — на первом запуске,
# недостающие строки .gitignore и .gitattributes и правила запрета .claude/settings.json; манифест сумм и коммит.
# Запуск на хосте в корне проекта: box-update [--force]; команду ставит ./agent-loop.sh в папке клона ссылкой в ~/.local/bin.
# Файлы agent-box — docs/PROTOCOL.md, .claude/context-guard.conf, папки .claude/skills/box-*/; их суммы и коммит клона — манифест .claude/agent-box.sha256.
# Файл agent-box, правленный в проекте, останавливает обновление без правок; --force кладёт свежую копию поверх правки.
# claude-box.yml — сервис claude этой машины, вне git: собирается из образца и docker compose config проекта, его сумма — последней строкой файла;
# правка руками, кроме строк CLAUDE_BOX_ALLOW и ANTHROPIC_MODEL, останавливает обновление, --force кладёт свежий файл, прежний — в claude-box.yml.old.
# Строки хаба, docs/RULES.md и docs/rules/ со ссылкой на раздел протокола или скилл box-* — правила проекта поверх agent-box: итог их называет,
# раздел или скилл, пропавший в новой версии, останавливает обновление. Итог с коммитом — записи журнала agent-box о правках template/ с прошлой версии.
# Код выхода: 0 — обновлено или нечего обновлять; 1 — остановка без правок; 2 — неверный запуск или нет нужной команды.
set -euo pipefail

say() { printf 'box-update: %s\n' "$*"; }
list() { printf '  %s\n' "$@"; }

# git по репозиторию проекта: команда fsmonitor и хуки из его .git выключены — их может подложить агент контейнера
g() { git -c core.fsmonitor=false -c core.hooksPath=/dev/null "$@"; }

force=
case $# in
  0) ;;
  1) [ "$1" = --force ] || { say "запуск: box-update [--force]"; exit 2; }; force=1 ;;
  *) say "запуск: box-update [--force]"; exit 2 ;;
esac
for cmd in git jq sha256sum tar docker; do
  command -v "$cmd" >/dev/null || { say "нет команды $cmd"; exit 2; }
done

# клон — папка скрипта: команда ведёт в него ссылкой из ~/.local/bin
clone=$(dirname "$(readlink -f "$0")")
if [ -f agent-loop.sh ] && [ -d template ]; then
  say "это клон agent-box: протокол и скиллы здесь — ссылки на оригиналы в template/, копия легла бы на сами оригиналы"
  exit 1
fi

# проект — текущая папка: пустая становится git-репозиторием, с файлами без git — остановка
if [ ! -e .git ]; then
  if [ -n "$(ls -A)" ]; then
    say "в папке нет git-репозитория, а файлы есть: что уйдёт в git первым коммитом, решаешь ты."
    say "сделай первый коммит проекта и запусти box-update снова; запуск — в корне проекта"
    exit 1
  fi
  g init -q
  say "пустая папка стала git-репозиторием"
fi

manifest=.claude/agent-box.sha256
first= fresh=
if [ ! -f "$manifest" ]; then
  first=1
  # проект прежней схемы — задача сборки документации уже заведена: его заготовки — документы проекта
  compgen -G 'docs/tasks/docs-*.md' >/dev/null || fresh=1
fi

# чистое дерево; правки пользователя в таск-файлах — ответ на блокер, правка «Постановки» — остаются вне коммита
keep=() bad=()
while IFS= read -r -d '' e; do
  p=${e:3}
  if [ -z "$fresh" ] && [[ $p == docs/tasks/* ]]; then keep+=("$p"); else bad+=("$p"); fi
  case ${e:0:2} in R* | C* | ?R | ?C) IFS= read -r -d '' p; bad+=("$p") ;; esac
done < <(g status --porcelain -z -uall)
if ((${#bad[@]})); then
  say "в проекте правки без коммита — закоммить их и запусти box-update снова:"
  list "${bad[@]}"
  exit 1
fi
if [ -f .claude/settings.json ] && ! jq -e . .claude/settings.json >/dev/null 2>&1; then
  say ".claude/settings.json — не JSON: правила запрета дописать некуда; почини файл и запусти box-update снова"
  exit 1
fi

# образец — из последнего коммита клона: правки клона без коммита в проект не уходят
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
rev=$(git -C "$clone" rev-parse HEAD)
git -C "$clone" archive "$rev" template | tar -x -C "$tmp"
t=$tmp/template
[ -z "$(git -C "$clone" status --porcelain -- template)" ] ||
  say "в клоне agent-box правки template/ без коммита — в проект ложится коммит ${rev:0:7}"

# файлы agent-box образца и заготовки — остальные файлы образца, кроме строк, настроек и claude-box.yml
(cd "$t" && find docs/PROTOCOL.md .claude/context-guard.conf .claude/skills/box-* -type f | LC_ALL=C sort) >"$tmp/box.list"
(cd "$t" && find . -type f | cut -c3- | LC_ALL=C sort) |
  grep -vxF -f "$tmp/box.list" |
  grep -vxE '\.gitignore|\.gitattributes|\.claude/settings\.json|claude-box\.yml' >"$tmp/skel.list" || true

# прежний манифест: строка коммита и суммы файлов
: >"$tmp/old.sums"
[ -z "$first" ] && grep -v '^#' "$manifest" >"$tmp/old.sums" || true
old_rev=
[ -n "$first" ] || old_rev=$(sed -n '1s/^# agent-box \([0-9a-f]\{7,40\}\)$/\1/p' "$manifest")
# папки box-* прежней версии и образца — целиком принадлежат обвязке
dirs=$( { cut -d' ' -f3 "$tmp/old.sums"; cat "$tmp/box.list"; } | grep '^\.claude/skills/box-' | cut -d/ -f1-3 | LC_ALL=C sort -u)

# пути записи и удаления — внутри папки проекта: скрипт работает на хосте, а ссылку в проекте мог подложить агент контейнера
root=$(pwd -P)
for p in $(cat "$tmp/box.list") $(cut -d' ' -f3 "$tmp/old.sums") $dirs .gitignore .gitattributes .claude/settings.json "$manifest" claude-box.yml \
  $(while IFS= read -r p; do [ -e "$p" ] || [ -L "$p" ] || echo "$p"; done <"$tmp/skel.list"); do
  case $(realpath -m -- "$p") in
    "$root"/*) ;;
    *) say "путь ведёт ссылкой за папку проекта: $p — убери ссылку и запусти box-update снова"; exit 1 ;;
  esac
done

# правила проекта поверх agent-box — строки хаба, docs/RULES.md и docs/rules/ со ссылкой на раздел протокола или скилл box-*;
# раздел или скилл, которого в новой версии нет, — остановка: правило проекта перестало бы действовать молча.
# Раздел — самый длинный заголовок прежнего или нового протокола в начале текста после «§»: так переименование
# «Сообщения пользователю» в «Сообщения» видно как пропажа. У нового проекта хаб и правила уходят в .old — проверки нет.
heads() { awk '/^```/ { f = !f; next } !f && /^#+[ \t]/ { sub(/^#+[ \t]+/, ""); sub(/[ \t]+$/, ""); print }' "$1"; }
heads "$t/docs/PROTOCOL.md" >"$tmp/heads.new"
{ cat "$tmp/heads.new"; [ ! -f docs/PROTOCOL.md ] || heads docs/PROTOCOL.md; } >"$tmp/heads.all"
section() {
  local h best=
  while IFS= read -r h; do
    case $1 in "$h" | "$h"[![:alnum:]_-]*) ((${#h} > ${#best})) && best=$h ;; esac
  done <"$tmp/heads.all"
  printf '%s' "$best"
}
re_sec='PROTOCOL\.md`?[[:space:]]*§[[:space:]]*(.*)'
re_box='(^|[^[:alnum:]_./-])/(box-[a-z0-9-]+)(.*)'
rules=() rgone=() rfiles=()
if [ -z "$fresh" ]; then
  for f in CLAUDE.md AGENTS.md docs/RULES.md; do [ -f "$f" ] && rfiles+=("$f"); done
  [ -d docs/rules ] && while IFS= read -r -d '' f; do rfiles+=("$f"); done < <(find docs/rules -type f -print0 | LC_ALL=C sort -z)
fi
if ((${#rfiles[@]})); then
  while IFS= read -r m; do
    f=${m%%:*}
    m=${m#*:}
    n=${m%%:*}
    text=${m#*:}
    live=() dead=()
    rest=$text
    while [[ $rest =~ $re_sec ]]; do
      rest=${BASH_REMATCH[1]}
      s=$(section "$rest")
      if [ -n "$s" ] && grep -qxF -- "$s" "$tmp/heads.new"; then live+=("PROTOCOL.md § $s")
      else dead+=("PROTOCOL.md § ${s:-$(sed 's/[,:;].*//' <<<"${rest:0:60}")}")
      fi
    done
    rest=$text
    while [[ $rest =~ $re_box ]]; do
      s=${BASH_REMATCH[2]}
      rest=${BASH_REMATCH[3]}
      if [ -d "$t/.claude/skills/$s" ]; then live+=("/$s"); else dead+=("/$s"); fi
    done
    if ((${#live[@]})); then j=$(printf '%s, ' "${live[@]}"); rules+=("$f:$n — ${j%, }"); fi
    if ((${#dead[@]})); then j=$(printf '%s, ' "${dead[@]}"); rgone+=("$f:$n — ${j%, }"); fi
  done < <(grep -HnE 'PROTOCOL\.md`?[[:space:]]*§|/box-[a-z0-9]' -- "${rfiles[@]}" || true)
fi

# claude-box.yml — образец с именем проекта Compose, путём /workspace/<проект>, сетью по умолчанию проекта
# и подключениями основного репозитория у дополнительной рабочей копии git; файл машины, поэтому сумма — в нём самом
cb=claude-box.yml
cbkeys='^[[:space:]]*(CLAUDE_BOX_ALLOW|ANTHROPIC_MODEL):'
cb_sum() { grep -vE "^# box-update |$cbkeys" "$1" | sha256sum | cut -c1-64; }
envkey() { [ -f .env ] && grep -Eq "^[[:space:]]*(export[[:space:]]+)?$1[[:space:]]*=" .env; }
compose=
for f in compose.yaml compose.yml docker-compose.yml docker-compose.yaml; do [ -f "$f" ] && compose=1; done
envkey COMPOSE_FILE && compose=1
cb_net= cb_svc= env_lines=
if [ -n "$compose" ]; then
  if envkey COMPOSE_PROJECT_NAME; then
    say "в .env строка COMPOSE_PROJECT_NAME: она сильнее строки name: в claude-box.yml и вернёт Claude в проект основного compose-файла"
    say "перенеси имя из этой строки в строку name: основного compose-файла и запусти box-update снова: проект сохранит имя, контейнеры и сеть"
    exit 1
  fi
  # все профили — сеть по умолчанию есть в выводе и у проекта, чьи сервисы все под профилями; файлы env_file сервисов не читаются
  if ! docker compose --profile '*' config --format json --no-env-resolution >"$tmp/compose.json" 2>"$tmp/compose.err"; then
    say "docker compose config в проекте упал — имя проекта и сеть для claude-box.yml взять неоткуда:"
    sed 's/^/  /' "$tmp/compose.err"
    exit 1
  fi
  name=$(jq -r .name "$tmp/compose.json")
  cb_net=$(jq -c '.networks.default // empty' "$tmp/compose.json")
  # сервис claude прежней схемы в compose-файле проекта: его строки адресов и модели — в claude-box.yml, сам сервис убирает человек
  if jq -e '.services.claude' "$tmp/compose.json" >/dev/null; then
    cb_svc=1
    env_lines=$(jq -r '.services.claude.environment // {} | to_entries[]
      | select((.key == "CLAUDE_BOX_ALLOW" or .key == "ANTHROPIC_MODEL") and .value != null) | "\(.key): \(.value | @json)"' "$tmp/compose.json")
  fi
else
  # без compose-файла — имя папки, приведённое, как в box-connect: путь в контейнере у обоих запусков один
  name=$(basename "$PWD" | tr A-Z a-z | tr -cd 'a-z0-9_-' | sed 's/^[-_]*//')
fi
# прежний файл: строки адресов и модели переносятся как есть; без строки суммы — файл прежней схемы, остаётся рядом в .old
cb_prev= cb_edit=
if [ -e "$cb" ]; then
  env_lines=$(grep -E "$cbkeys" "$cb" | sed 's/^[[:space:]]*//' || true)
  rec=$(sed -n 's/^# box-update \([0-9a-f]\{64\}\) .*/\1/p' "$cb" | tail -1)
  if [ -z "$rec" ]; then cb_prev=1
  elif [ "$rec" != "$(cb_sum "$cb")" ]; then cb_edit=1
  fi
fi
wt=
if [ -f .git ]; then
  gd=$(g rev-parse --path-format=absolute --git-common-dir)
  wt=$(printf '      - %s\n' "$gd:$gd" "$gd/config:$gd/config:ro" "$gd/hooks:$gd/hooks:ro" "$gd/info:$gd/info:ro")
fi
NAME=$name NET=$cb_net WT=$wt \
  MODEL=$(grep -m1 '^ANTHROPIC_MODEL:' <<<"$env_lines" || true) ALLOW=$(grep -m1 '^CLAUDE_BOX_ALLOW:' <<<"$env_lines" || true) awk '
  /^# сеть по умолчанию/ && ENVIRON["NET"] == "" { exit }
  /^  default:$/ { print "  default: " ENVIRON["NET"]; exit }
  { gsub(/<проект>/, ENVIRON["NAME"]) }
  /^[[:space:]]*ANTHROPIC_MODEL:/ {
    print (ENVIRON["MODEL"] == "" ? $0 : "      " ENVIRON["MODEL"])
    if (ENVIRON["ALLOW"] != "") print "      " ENVIRON["ALLOW"]
    next
  }
  ENVIRON["WT"] != "" && /^[[:space:]]*- \.\/\.git\// { if (!w++) print ENVIRON["WT"]; next }
  { print }
' "$t/$cb" >"$tmp/cb"
printf '# box-update %s — сумма файла без этой строки и строк CLAUDE_BOX_ALLOW и ANTHROPIC_MODEL\n' "$(cb_sum "$tmp/cb")" >>"$tmp/cb"

# правки проекта в файлах agent-box: сумма разошлась, файл убран или добавлен в папку box-*
edits=()
while read -r sum p; do
  if [ ! -f "$p" ]; then
    edits+=("$p — убран")
  elif [ "$(sha256sum <"$p" | cut -c1-64)" != "$sum" ]; then
    edits+=("$p — изменён")
  fi
done <"$tmp/old.sums"
if [ -z "$first" ]; then
  for d in $dirs; do
    [ -d "$d" ] || continue
    while IFS= read -r p; do
      cut -d' ' -f3 "$tmp/old.sums" | grep -qxF -- "$p" || edits+=("$p — добавлен")
    done < <(find "$d" -type f | LC_ALL=C sort)
  done
fi
stop=
if ((${#edits[@]})) && [ -z "$force" ]; then
  say "файлы agent-box правлены в проекте — свежая копия легла бы поверх правки:"
  list "${edits[@]}"
  say "перенеси правку в docs/RULES.md правилом «вместо PROTOCOL.md § <раздел>: …» или «к /box-… шаг <N>: …»"
  say "и запусти box-update --force: свежая копия ляжет поверх, прежний текст останется в истории git"
  stop=1
fi
if [ -n "$cb_edit" ] && [ -z "$force" ]; then
  say "claude-box.yml правлен руками — свежий файл лёг бы поверх правки; что изменит box-update:"
  diff -u --label "$cb сейчас" --label "$cb от box-update" "$cb" "$tmp/cb" | sed 's/^/  /' || true
  say "строки CLAUDE_BOX_ALLOW и ANTHROPIC_MODEL box-update переносит сам; с другой правкой запусти box-update --force:"
  say "свежий файл ляжет поверх, прежний останется рядом — claude-box.yml.old"
  stop=1
fi
if ((${#rgone[@]})); then
  say "правила проекта называют разделы протокола или скиллы, которых в новой версии agent-box нет, — после обновления правила перестали бы действовать:"
  list "${rgone[@]}"
  say "разделы нового протокола: $(paste -sd '|' "$tmp/heads.new" | sed 's/|/; /g')"
  say "скиллы: $(cd "$t/.claude/skills" && printf '/%s ' box-*)"
  say "поправь правила под новую версию, закоммить и запусти box-update снова"
  stop=1
fi
[ -z "$stop" ] || exit 1

# первый запуск нового проекта: занятые имена заготовок, файлов agent-box и раздела по областям — в .old, .old2…
renamed=() hidden=()
oldname() {
  local n=$1.old i=2
  while [ -e "$n" ] || [ -L "$n" ]; do n=$1.old$i; i=$((i + 1)); done
  printf '%s' "$n"
}
if [ -n "$fresh" ]; then
  for p in $(grep -vE '^docs/(tasks|researches)/' "$tmp/skel.list") docs/PROTOCOL.md .claude/context-guard.conf \
    docs/tasks docs/researches docs/architecture docs/rules; do
    [ -e "$p" ] || [ -L "$p" ] || continue
    n=$(oldname "$p")
    if g check-ignore -q "$p"; then hidden+=("/$n"); fi
    mv "$p" "$n"
    renamed+=("$p → $n")
  done
fi

# прежний claude-box.yml — правленный руками при --force или прежней схемы — рядом в .old
cb_old=
if [ -n "$cb_prev$cb_edit" ]; then
  cb_old=$(oldname "$cb")
  mv "$cb" "$cb_old"
fi

# состояние файлов agent-box до копии — для итога
units=$(printf '%s\n' docs/PROTOCOL.md .claude/context-guard.conf $dirs)
unit_sum() { [ -e "$1" ] && find "$1" -type f | LC_ALL=C sort | xargs -r -d '\n' sha256sum | sha256sum | cut -c1-64 || true; }
declare -A before
for u in $units; do before[$u]=$(unit_sum "$u"); done

# файлы agent-box: прежние файлы манифеста и папки box-* — прочь, образец — свежей копией
cut -d' ' -f3 "$tmp/old.sums" | while IFS= read -r p; do rm -f -- "$p"; done
for d in $dirs; do rm -rf -- "$d"; done
while IFS= read -r p; do
  mkdir -p "$(dirname "$p")"
  rm -f -- "$p"
  cp "$t/$p" "$p"
done <"$tmp/box.list"
cb_new=
if ! cmp -s "$tmp/cb" "$cb"; then
  [ -e "$cb" ] && cb_new=обновлён || cb_new=собран
  rm -f -- "$cb"
  cp "$tmp/cb" "$cb"
fi

# заготовки — на первом запуске, только недостающие; при разделе по областям основной файл живёт в папке раздела
laid=()
if [ -n "$first" ]; then
  while IFS= read -r p; do
    [ -e "$p" ] || [ -L "$p" ] && continue
    [ "$p" = docs/RULES.md ] && [ -d docs/rules ] && continue
    [ "$p" = docs/ARCHITECTURE.md ] && [ -d docs/architecture ] && continue
    mkdir -p "$(dirname "$p")"
    cp "$t/$p" "$p"
    laid+=("$p")
  done <"$tmp/skel.list"
fi

# строки: недостающие строки файла образца — в конец, с комментариями над ними в образце; файла нет — копия образца
declare -A added
append() {
  local f=$1
  shift
  [ -z "$(tail -c1 "$f")" ] || echo >>"$f"
  printf '%s\n' "$@" >>"$f"
}
add_lines() {
  local f=$1 line com=()
  if [ ! -e "$f" ]; then
    cp "$t/$f" "$f"
    added[$f]="копия образца"
    return
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      '#'*) com+=("$line"); continue ;;
      '') com=(); continue ;;
    esac
    if ! grep -qxF -- "$line" "$f"; then
      append "$f" "${com[@]}" "$line"
      added[$f]+="${added[$f]:+, }$line"
    fi
    com=()
  done <"$t/$f"
}
add_lines .gitignore
add_lines .gitattributes
if ((${#hidden[@]})); then
  append .gitignore '# сборка документации: бывшее под gitignore' "${hidden[@]}"
  added[.gitignore]+="${added[.gitignore]:+, }${hidden[*]}"
fi
if [ -n "$cb_old" ] && ! g check-ignore -q "$cb_old"; then
  append .gitignore '# прежний claude-box.yml — файл машины' "/$cb_old"
  added[.gitignore]+="${added[.gitignore]:+, }/$cb_old"
fi

# правила запрета: недостающие правила образца — дописать, правила прежнего образца на правку compose-файлов — убрать
old_rules='["Edit(/compose.yaml)","Edit(/compose.yml)","Edit(/docker-compose.yaml)","Edit(/docker-compose.yml)",
  "Edit(/compose.override.yaml)","Edit(/compose.override.yml)","Edit(/docker-compose.override.yaml)","Edit(/docker-compose.override.yml)"]'
rules_in= rules_out=
s=.claude/settings.json
if [ ! -e "$s" ]; then
  cp "$t/$s" "$s"
  rules_in="копия образца"
else
  tpl=$(jq -c '.permissions.deny' "$t/$s")
  rules_in=$(jq -r --argjson tpl "$tpl" '$tpl - (.permissions.deny // []) | join(", ")' "$s")
  rules_out=$(jq -r --argjson old "$old_rules" '[(.permissions.deny // [])[] | select(IN($old[]))] | join(", ")' "$s")
  if [ -n "$rules_in$rules_out" ]; then
    jq --argjson tpl "$tpl" --argjson old "$old_rules" \
      '(.permissions.deny // []) as $d | .permissions.deny = (($d - $old) + ($tpl - $d))' "$s" >"$tmp/settings.json"
    cat "$tmp/settings.json" >"$s"
  fi
fi

# манифест: коммит клона и суммы файлов agent-box
{
  printf '# agent-box %s\n' "$rev"
  xargs -d '\n' sha256sum <"$tmp/box.list"
} >"$tmp/manifest"

# итог по claude-box.yml — и без коммита: файл вне git
cb_report() {
  if [ -n "$cb_new" ]; then
    say "claude-box.yml $cb_new: проект Compose $name-claude, папка в контейнере /workspace/$name"
    if [ -n "$cb_net" ]; then list "сеть $(jq -r .name <<<"$cb_net") — из docker compose config проекта"
    elif [ -n "$compose" ]; then list "без блока сети: у проекта нет сети по умолчанию"
    else list "без блока сети: у проекта нет compose-файла"
    fi
    [ -z "$wt" ] || list "рабочая копия git: подключён .git основного репозитория $gd"
    [ -z "$env_lines" ] || list "перенесены строки: $(cut -d: -f1 <<<"$env_lines" | paste -sd, - | sed 's/,/, /g')"
    [ -z "$cb_old" ] || list "прежний файл — $cb_old: свои строки сверь с новым"
  fi
  [ -z "$cb_svc" ] || say "сервис claude остался в compose-файле проекта — убери его строки: контейнер Claude теперь из claude-box.yml"
}

rules_report() {
  ((${#rules[@]} == 0)) || { say "правила проекта поверх agent-box — при споре главнее протокола и скиллов:"; list "${rules[@]}"; }
}

# что изменилось — записи журнала agent-box, чьи коммиты меняли template/ между версией манифеста и новой;
# коммиты без записи — строкой сообщения: запись журнала ложится, когда задача agent-box готова
changes_report() {
  [ -n "$old_rev" ] && [ "$old_rev" != "$rev" ] || return 0
  if ! git -C "$clone" cat-file -e "$old_rev^{commit}" 2>/dev/null; then
    say "коммита прежней версии ${old_rev:0:7} в клоне agent-box нет — что изменилось, не собрать"
    return 0
  fi
  git -C "$clone" rev-list "$old_rev..$rev" -- template >"$tmp/commits"
  [ -s "$tmp/commits" ] || return 0
  # строки журнала, кроме записей, — пустые: номера строк остаются
  { git -C "$clone" show "$rev:docs/JOURNAL.md" 2>/dev/null || true; } | sed '/^- \*\*/!s/.*//' >"$tmp/journal"
  grep -noE '`[0-9a-f]{7,40}`' "$tmp/journal" | sed 's/^\([0-9]*\):`\([0-9a-f]\{7\}\).*/\1 \2/' >"$tmp/jhash" || true
  awk 'FILENAME == ARGV[1] { c[substr($1, 1, 7)]; next } FILENAME == ARGV[2] { if ($2 in c) l[$1]; next }
    FNR in l { print "    " $0 }' "$tmp/commits" "$tmp/jhash" "$tmp/journal" >"$tmp/entries"
  awk 'FILENAME == ARGV[1] { j[$2]; next } !(substr($1, 1, 7) in j)' "$tmp/jhash" "$tmp/commits" >"$tmp/bare"
  say "что изменилось в agent-box с ${old_rev:0:7}:"
  [ ! -s "$tmp/entries" ] || { list "записи журнала agent-box:"; cat "$tmp/entries"; }
  [ ! -s "$tmp/bare" ] || { list "коммиты без записи журнала:"; xargs git -C "$clone" log --no-walk=unsorted --format='    %h %s' <"$tmp/bare"; }
}

# правки обновления — без таск-файлов пользователя и манифеста; правок нет и манифест есть — коммита нет
ex=()
for p in "${keep[@]}"; do ex+=(":(exclude,literal)$p"); done
if [ -z "$first" ] && [ -z "$(g status --porcelain -uall -- . "${ex[@]}" ":(exclude,literal)$manifest")" ]; then
  say "обвязка свежая — agent-box ${rev:0:7}, правок нет, коммита нет"
  cb_report
  rules_report
  exit 0
fi
cp "$tmp/manifest" "$manifest"

# итог
[ -z "$first" ] || { [ -n "$fresh" ] && say "первый запуск в проекте" || say "первый запуск в проекте прежней схемы: файлы agent-box — свежей копией, документы остаются как есть"; }
((${#edits[@]} == 0)) || { say "правки проекта в файлах agent-box легли под свежую копию (--force):"; list "${edits[@]}"; }
((${#renamed[@]} == 0)) || { say "занятые имена переименованы:"; list "${renamed[@]}"; }
new=() upd=() gone=()
for u in $units; do
  a=$(unit_sum "$u")
  if [ -z "${before[$u]}" ] && [ -n "$a" ]; then new+=("$u")
  elif [ -n "${before[$u]}" ] && [ -z "$a" ]; then gone+=("$u")
  elif [ "${before[$u]}" != "$a" ]; then upd+=("$u")
  fi
done
((${#new[@]} == 0)) || { say "файлы agent-box легли впервые:"; list "${new[@]}"; }
((${#upd[@]} == 0)) || { say "файлы agent-box обновлены:"; list "${upd[@]}"; }
((${#gone[@]} == 0)) || { say "файлы agent-box убраны — их нет в новой версии:"; list "${gone[@]}"; }
((${#laid[@]} == 0)) || { say "заготовки легли:"; list "${laid[@]}"; }
cb_report
for f in .gitignore .gitattributes; do
  [ -z "${added[$f]:-}" ] || say "$f: ${added[$f]}"
done
[ -z "$rules_in" ] || say ".claude/settings.json, правила запрета дописаны: $rules_in"
[ -z "$rules_out" ] || say ".claude/settings.json, правила прежнего образца убраны: $rules_out"
ign=$({ cat "$tmp/box.list"; printf '%s\n' "${laid[@]}" "$manifest"; } | g check-ignore --stdin || true)
[ -z "$ign" ] || { say "под .gitignore проекта — в git не попадут:"; list $ign; }
rules_report
changes_report

g add -A -- . "${ex[@]}"
g commit -q -m "chore(box): agent-box ${rev:0:7}"
say "коммит $(g rev-parse --short HEAD) chore(box): agent-box ${rev:0:7}"
((${#keep[@]} == 0)) || { say "правки таск-файлов остались вне коммита:"; list "${keep[@]}"; }
